# Disable directory browsing
Options -Indexes

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization header for APIs
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ------------------------------------------------------------------
    # Sibling apps — never rewrite into the Staff Portal SPA
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_URI} /(helpdesk|finance|apm)(/|$) [NC]
    RewriteRule ^.*$ - [L]
    RewriteRule ^(helpdesk|finance|apm)(/|$) - [L]

    # Block any leftover CI archive path
    RewriteRule ^old-staff-portal(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} /old-staff-portal(/|$) [NC]
    RewriteRule ^.*$ - [F,L]

    # Deny direct web access to shared cache JSON
    RewriteRule ^cache(/|$) - [F,L]

    # ------------------------------------------------------------------
    # Legacy /staff/staff-portal/* → new root URLs (301)
    # Use THE_REQUEST so this fires on the original client URL even when
    # Apache has already mapped into the physical staff-portal/ directory.
    # ------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+(?:demo_staff|staff)/staff-portal/backend[/?\s] [NC]
    RewriteRule ^staff-portal/backend(?:/(.*))?$ /staff/backend/$1 [R=301,L,QSA]

    RewriteCond %{THE_REQUEST} \s/+(?:demo_staff|staff)/staff-portal/assets/ [NC]
    RewriteRule ^staff-portal/assets/([^/\s]+)$ /staff/assets/$1 [R=301,L,QSA]

    RewriteCond %{THE_REQUEST} \s/+(?:demo_staff|staff)/staff-portal[/?\s] [NC]
    RewriteRule ^staff-portal(?:/(.*))?$ /staff/$1 [R=301,L,QSA]

    # ------------------------------------------------------------------
    # Staff Portal as web root
    # backend/ is a symlink → staff-portal/backend (Laravel)
    # Vite hashed assets are single-segment filenames under /assets/
    # ------------------------------------------------------------------
    RewriteRule ^assets/([^/]+)$ staff-portal/spa-static.php?f=$1 [L,QSA]
    RewriteCond %{REQUEST_URI} /(demo_staff|staff)/assets/([^/]+)$ [NC]
    RewriteRule ^.*$ staff-portal/spa-static.php?f=%2 [L,QSA]

    # Africa map from published SPA
    RewriteRule ^maps/([^/]+)$ staff-portal/public-spa/maps/$1 [L]

    # Staff Share reference API (APM sync)
    RewriteRule ^share/(get_current_staff|divisions|directorates|token|docs|openapi\.yaml|openapi)(/.*)?$ /staff/backend/share/$1$2 [R=307,L,QSA]

    # CI3-compatible SSO launch / CSRF / session refresh → Laravel
    RewriteRule ^home/launch_module$ /staff/backend/home/launch_module [R=307,L,QSA]
    RewriteRule ^auth/refreshCSRF$ /staff/backend/auth/refreshCSRF [R=307,L,QSA]
    RewriteRule ^auth/refresh_sso_session$ /staff/backend/auth/refresh_sso_session [R=307,L,QSA]
    RewriteCond %{REQUEST_URI} /(demo_staff|staff)/home/launch_module/?$ [NC]
    RewriteRule ^.*$ /staff/backend/home/launch_module [R=307,L,QSA]
    RewriteCond %{REQUEST_URI} /(demo_staff|staff)/auth/refreshCSRF/?$ [NC]
    RewriteRule ^.*$ /staff/backend/auth/refreshCSRF [R=307,L,QSA]
    RewriteCond %{REQUEST_URI} /(demo_staff|staff)/auth/refresh_sso_session/?$ [NC]
    RewriteRule ^.*$ /staff/backend/auth/refresh_sso_session [R=307,L,QSA]

    # Existing files/dirs (including backend symlink, uploads, legacy assets/)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA catch-all
    RewriteRule ^ staff-portal/spa-static.php [L,QSA]

    RewriteRule (^|/)\.env - [F,L]
    RedirectMatch 404 /\.git
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 staff-portal/spa-static.php
</IfModule>

ServerSignature Off
