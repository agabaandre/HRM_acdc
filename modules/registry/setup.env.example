# Finance installer configuration
# Copy and edit before running ./setup-production.sh:
#   cp setup.env.example setup.env
#
# Values here are written into finance/.env (existing keys are updated).

# --- URLs (Apache layout beside Staff at /staff/finance/) ---
# Local dev: keep localhost below.
# Production: leave blank or keep localhost — ./setup-production.sh auto-fills from
#   ../.env (PRODUCTION_URL / CI_BASE_URL / BASE_URL) or the server hostname (https).
APP_URL=http://localhost/staff/finance
BASE_URL=http://localhost/staff/
FINANCE_ASSETS_BASE_URL=http://localhost/staff/apm
FINANCE_STAFF_PORTAL_URL=http://localhost/staff
VITE_APP_BASE_PATH=/staff/finance/

# --- Application ---
APP_ENV=local
APP_DEBUG=true
# Production: use ./setup-production.sh (sets APP_ENV=production, APP_DEBUG=false by default)

# --- Production deploy (setup-production.sh) ---
# Web server user/group for storage permissions (Linux: www-data).
# FINANCE_USER=www-data
# FINANCE_GROUP=www-data
# PHP_BIN=/usr/bin/php
# If a previous setup used sudo, run: ./fix-storage-permissions.sh

# --- Database ---
# Leave DB_PASSWORD blank to copy DB_PASS from ../.env (setup.sh and setup-production.sh)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=root
DB_PASSWORD=

# --- APM database (division / funder mapping pages) ---
# Leave blank to inherit from modules/apm/.env (DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD).
APM_DB_HOST=
APM_DB_PORT=
APM_DB_DATABASE=
APM_DB_USERNAME=
APM_DB_PASSWORD=

# --- SSO / Staff API ---
# Leave blank: setup inherits from staff root .env / APM, or generates JWT_SECRET /
# SESSION_SECRET on production setup (shared across CBP apps). Do not commit secrets.
# JWT_SECRET: /staff/.env (shared/load-staff-root-env.php)
# SESSION_SECRET: /staff/.env
STAFF_API_USERNAME=
STAFF_API_PASSWORD=
STAFF_API_TOKEN=
# Auto-generated by ./setup.sh / configure-env.sh when blank (shared with APM).
# Shared with APM (budget-execution + SAP→APM fund-code sync JWT mint)
# FINANCE_APM_BRIDGE_SECRET=

# --- Azure Blob (SAP dumps) — do not commit real keys; set in setup.env ---
# AZURE_SAP_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_SAP_ACCOUNT_NAME=
# AZURE_SAP_ACCOUNT_KEY=
# AZURE_SAP_CONTAINER=sap
# AZURE_SAP_PREFIX=
# AZURE_SAP_TIMEOUT=60
# AZURE_SAP_POLL_HOURS=4
# AZURE_SAP_DELETE_AFTER_FETCH=true
