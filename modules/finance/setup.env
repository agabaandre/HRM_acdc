# Finance installer configuration
# Copy and edit before running ./setup-production.sh:
#   cp setup.env.example setup.env
#
# Values here are written into finance/.env (existing keys are updated).

# --- URLs (Apache layout beside Staff at /staff/finance/) ---
APP_URL=http://localhost/staff/finance
BASE_URL=http://localhost/staff/
FINANCE_ASSETS_BASE_URL=http://localhost/staff/apm
FINANCE_STAFF_PORTAL_URL=http://localhost/staff
VITE_APP_BASE_PATH=/staff/finance/

# --- Application ---
APP_ENV=local
APP_DEBUG=true
# Production: use ./setup-production.sh (sets APP_ENV=production, APP_DEBUG=false by default)

# --- Production deploy (setup-production.sh) ---
# FINANCE_USER=www-data
# FINANCE_GROUP=www-data
# PHP_BIN=/usr/bin/php

# --- Database ---
# Quick local dev without MySQL: DB_CONNECTION=sqlite (setup creates database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=root
DB_PASSWORD=

# --- SSO / Staff API (leave blank to copy from ../.env or ../apm/.env when present) ---
JWT_SECRET=
SESSION_SECRET=
STAFF_API_USERNAME=
STAFF_API_PASSWORD=
STAFF_API_TOKEN=
