<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Laravel API / SSO under …/finance/backend/*
    RewriteRule ^backend(/|$) - [L]

    # Compat: old /finance/sso/* → /finance/backend/sso/* (portal now uses /backend)
    RewriteRule ^sso/(.*)$ /staff/finance/backend/sso/$1 [R=307,L,QSA]
    RewriteRule ^api/(.*)$ /staff/finance/backend/api/$1 [R=307,L,QSA]

    # Real files at module root (README, etc.) — not directories
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Vite hashed assets from dist-build
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ frontend/dist-build/$1 [L]

    # SPA fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ frontend/dist-build/index.html [L]
</IfModule>

ServerSignature Off
