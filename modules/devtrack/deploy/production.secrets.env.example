# Production secrets template — PLACEHOLDERS ONLY.
#
# Exchange / SMTP credentials are configured in the admin UI (encrypted in DB),
# not in this file.
#
#   cp docker/.env.example docker/.env
#   cp backend/.env.example backend/.env
#   chmod 600 docker/.env backend/.env
#   # edit both files with real secrets below
#   ./setup.sh

DOMAIN=notifications.africacdc.org
ADMIN_EMAIL=andrewa@africacdc.org
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_TTL=60
EMAIL_SERVER_DATA_PATH=/home/email_serverdata
CERTBOT_EMAIL=andrewa@africacdc.org
API_HOST_PORT=8089
MYSQL_HOST_PORT=3309

# Optional — auto-generated by setup when using --write-env
INTEGRATION_CLIENT_SECRET=

# Simple word+number image CAPTCHA for login, send email, and provider test (on by default)
CAPTCHA_ENABLED=true
CAPTCHA_LENGTH=5
CAPTCHA_TTL=600

# Optional deploy flags
QUEUE_SCALE=2
RUN_SEEDER=true
# SKIP_SSL=false
