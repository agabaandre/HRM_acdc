APP_NAME="Africa CDC Staff Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/staff/staff-portal/backend

STAFF_PORTAL_BASE_URL=http://localhost/staff/staff-portal/backend/
STAFF_PORTAL_SPA_ENABLED=false
STAFF_PORTAL_SPA_URL=http://localhost:5175/
BASE_URL=http://localhost/staff/
JWT_SECRET=

# Staff Share API (APM sync) — same token APM uses in /share/.../{token} URLs
STAFF_API_TOKEN=YWZyY2FjZGNzdGFmZnRyYWNrZXI
SHARE_JWT_TTL=3600
SHARE_JWT_AUDIENCE=share-api

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staff
DB_USERNAME=root
DB_PASSWORD=

STAFF_LEGACY_SCHEMA_SKIP=true
STAFF_AUDIT_INTEGRITY_CHAIN=true
STAFF_SSO_TOKEN_TTL=7200

# Staff ecosystem file storage (outside git) — see docs/STORAGE.md
# STAFF_DATA_ROOT=/var/staffdata/localhost-staff
# STAFF_USE_HOST_STORAGE=true
# STAFF_PORTAL_UPLOADS_ROOT=/var/staffdata/localhost-staff/ci
# STAFF_PORTAL_MODULE_FILES_ROOT=/var/staffdata/localhost-staff/staff-portal

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cache / queue — database by default (Redis optional; enable after Redis is verified)
CACHE_STORE=database
CACHE_PREFIX=staff_portal
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# STAFF_PORTAL_REFERENCE_CACHE_TTL=300
# STAFF_PORTAL_READ_CACHE_ENABLED=true
# STAFF_PORTAL_READ_CACHE_TTL=60

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Microsoft SSO (same Azure app as CI3 — copy TENANT_ID / CLIENT_ID / CLIENT_SEC_VALUE from staff/.env)
TENANT_ID=
CLIENT_ID=
CLIENT_SEC_VALUE=
# Must match Azure app redirect URI (Apache /backend path — not php artisan serve :8081)
MICROSOFT_REDIRECT_URI=http://localhost/staff/staff-portal/backend/auth/microsoft/callback
# MICROSOFT_REDIRECT_URI=https://cbp.africacdc.org/staff/staff-portal/backend/auth/microsoft/callback
ALLOW_ALTERNATIVE_LOGIN=false
APM_BASE_URL=

# Africa CDC PRA public workplan sync (fallback until Settings → Workplan / PRA is saved)
PRA_WORKPLAN_API_URL=https://pra.africacdc.org/api/public/workplan
PRA_WORKPLAN_API_KEY=
PRA_WORKPLAN_TIERS=3,4
# Unused — sync always uses the current calendar year unless Settings → Workplan / PRA pins one.
# PRA_WORKPLAN_FISCAL_YEAR=
# PRA division codes to sync (comma-separated). Empty / all / * = every local short code.
# PRA_WORKPLAN_DIVISIONS=MIS,HRM,EPR
PRA_WORKPLAN_DIVISIONS=
# Map PRA division.code → local divisions.division_short_name (comma-separated)
PRA_WORKPLAN_DIVISION_ALIASES=MIS:DHIS
# PRA_WORKPLAN_TIMEOUT=60

DB_QUEUE_TABLE=sp_queue_jobs
DB_QUEUE_BATCHES_TABLE=sp_job_batches
DB_QUEUE_FAILED_TABLE=sp_failed_jobs

# Microsoft Graph / Exchange mail (default mailer)
MAIL_MAILER=exchange
USE_EXCHANGE_EMAIL=true
EXCHANGE_TENANT_ID=
EXCHANGE_CLIENT_ID=
EXCHANGE_CLIENT_SECRET=
EXCHANGE_REDIRECT_URI=
EXCHANGE_SCOPE=https://graph.microsoft.com/.default
EXCHANGE_AUTH_METHOD=client_credentials

# Notification audit BCC (system inbox only — never registry@)
MAIL_CC_ADDRESS=system@africacdc.org
# JOBS_SYSTEM_EMAIL=system@africacdc.org
# JOBS_CONTRACTS_COPIED_EMAILS=
# JOBS_MAIL_LOGO_URL=
# JOBS_PORTAL_BASE_URL=
