# =============================================================================
# CPHIA — cphia.africacdc.org (reverse proxy → 127.0.0.1:3000)
# Deploy as: /etc/nginx/sites-enabled/cphia-frontend.conf
#
# Also deploy: cphia-laravel.conf (Laravel vhost — must NOT use http2 on listen)
#
# Test: sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

# These directives run in http { } context (included via sites-enabled/*).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone  $binary_remote_addr zone=cphia_general:10m rate=10r/s;
limit_req_zone  $binary_remote_addr zone=cphia_login:10m  rate=5r/m;
limit_conn_zone $binary_remote_addr zone=cphia_conn:10m;

# -----------------------------------------------------------------------------
# HTTPS — primary site
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cphia.africacdc.org;

    # Hide version information
    server_tokens off;

    # Request / connection limits (mitigate slowloris & oversized payloads)
    client_max_body_size         50M;
    client_body_buffer_size      128k;
    client_body_timeout          30s;
    client_header_timeout        30s;
    client_header_buffer_size    1k;
    large_client_header_buffers  4 8k;
    keepalive_timeout            65s;
    send_timeout                 30s;

    # TLS certificates (Let's Encrypt)
    ssl_certificate     /etc/letsencrypt/live/cphia.africacdc.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cphia.africacdc.org/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;

    charset utf-8;

    # Rate limiting (zones defined at top of this file)
    limit_req  zone=cphia_general burst=20 nodelay;
    limit_conn cphia_conn 20;

    # -------------------------------------------------------------------------
    # Security headers
    # -------------------------------------------------------------------------
    add_header X-Frame-Options                    "DENY" always;
    add_header X-Content-Type-Options             "nosniff" always;
    add_header X-Download-Options                 "noopen" always;
    add_header X-DNS-Prefetch-Control             "off" always;
    add_header X-Permitted-Cross-Domain-Policies  "none" always;
    add_header Referrer-Policy                    "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy                 "accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()" always;
    add_header Cross-Origin-Opener-Policy           "same-origin" always;
    add_header Cross-Origin-Resource-Policy       "same-origin" always;
    add_header Strict-Transport-Security            "max-age=63072000; includeSubDomains; preload" always;

    # Tune script-src/style-src if the app breaks (Next.js often needs 'unsafe-inline').
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: blob:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https: blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests;" always;

    # -------------------------------------------------------------------------
    # Block unsupported HTTP methods
    # -------------------------------------------------------------------------
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    # -------------------------------------------------------------------------
    # Block dotfiles, VCS metadata, backups, and common scanner targets
    # -------------------------------------------------------------------------
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    location ~* \.(env|git|bak|sql|old|swp|ini|log|conf|cfg|yml|yaml|pem|key|crt|p12|pfx)$ {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    location ~* ^/(?:\.git|\.svn|\.hg|wp-admin|wp-login\.php|phpmyadmin|pma|adminer|\.aws|actuator|server-status)(?:/|$) {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    # Stricter rate limit on likely auth endpoints
    location ~* ^/(?:api/)?(?:auth|login|signin|signup|register|password|reset|oauth)(?:/|$) {
        limit_req zone=cphia_login burst=5 nodelay;

        proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering          on;
        proxy_buffer_size        16k;
        proxy_buffers            16 16k;
        proxy_busy_buffers_size  64k;
        proxy_redirect           off;

        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # Application reverse proxy
    # -------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering          on;
        proxy_buffer_size        16k;
        proxy_buffers            16 16k;
        proxy_busy_buffers_size  64k;
        proxy_redirect           off;

        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # Compression (only for static/text responses nginx serves directly)
    # -------------------------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml;
}

# -----------------------------------------------------------------------------
# HTTP — ACME challenges + force HTTPS
# -----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name cphia.africacdc.org;

    server_tokens off;

    # Let's Encrypt HTTP-01 challenge (adjust root to your certbot webroot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
