# Staff Portal installer configuration
# Copy and edit before running ./setup.sh:
#   cp setup.env.example setup.env
#
# Values here are written into staff-portal/backend/.env (existing keys are updated).

# --- URLs (Apache layout — no /public in API path) ---
# Local: http://localhost/staff/... — avoid macOS .local hostnames for SSO.
# Production: leave localhost — ./setup-production.sh auto-fills from ../.env
#   (PRODUCTION_URL / CI_BASE_URL / BASE_URL), Apache ServerName, or hostname -f.
# Optional override when those still say localhost:
# STAFF_PORTAL_PUBLIC_URL=https://cbp.africacdc.org/staff/
APP_URL=http://localhost/staff/staff-portal/backend
STAFF_PORTAL_BASE_URL=http://localhost/staff/staff-portal/backend/
STAFF_PORTAL_SPA_URL=http://localhost/staff/staff-portal/
STAFF_PORTAL_SPA_ENABLED=true
BASE_URL=http://localhost/staff/
APM_BASE_URL=http://localhost/staff/apm
# Azure app redirect URI must match (no /public):
# Must match Azure app registration (use /backend/, not /public/ or :8081)
# MICROSOFT_REDIRECT_URI=http://localhost/staff/staff-portal/backend/auth/microsoft/callback
# MICROSOFT_REDIRECT_URI=https://cbp.africacdc.org/staff/staff-portal/backend/auth/microsoft/callback

# --- Application ---
APP_NAME="Africa CDC Staff Portal"
APP_ENV=local
APP_DEBUG=true
# Production: use ./setup-production.sh (sets APP_ENV=production, APP_DEBUG=false)

# --- Database (shared staff MySQL; leave blanks to inherit from ../.env) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staff
DB_USERNAME=root
DB_PASSWORD=

# --- SSO (leave blank — copied from ../.env at setup) ---
JWT_SECRET=
STAFF_SSO_TOKEN_TTL=7200
# Microsoft SSO (leave blank — copied from ../.env: TENANT_ID, CLIENT_ID, CLIENT_SEC_VALUE)
TENANT_ID=
CLIENT_ID=
CLIENT_SEC_VALUE=

# --- Systemd (Linux servers) ---
# auto = install on Linux when systemctl exists; true = always try; false = skip
INSTALL_SYSTEMD=auto
STAFF_PORTAL_USER=www-data
STAFF_PORTAL_GROUP=www-data
PHP_BIN=/usr/bin/php
STAFF_PORTAL_HEALTH_URL=http://127.0.0.1/staff/staff-portal/backend/up

# --- Frontend build (Vite production) ---
# For demo hosts under /demo_staff/staff-portal/ use:
#   VITE_STAFF_PORTAL_API_BASE_URL=/demo_staff/staff-portal/backend
#   VITE_STAFF_PORTAL_BASE_PATH=/demo_staff/staff-portal/
# setup-production.sh auto-detects demo_staff from the parent folder name.
VITE_STAFF_PORTAL_API_BASE_URL=/staff/staff-portal/backend
VITE_STAFF_PORTAL_BASE_PATH=/staff/staff-portal/

# --- Shared file storage (outside git — see docs/STORAGE.md) ---
# false = skip | true = migrate CI3+APM to /var/staffdata | ask = prompt during setup
MIGRATE_SHARED_STORAGE=ask
# After a successful CI migrate: false | true | ask — archives uploads/ and symlinks to host ci/
PURGE_CI_UPLOADS_AFTER_MIGRATE=ask
# STAFF_DATA_ROOT=/var/staffdata/localhost-staff
# STAFF_USE_HOST_STORAGE=true
# STAFF_PORTAL_UPLOADS_ROOT=/var/staffdata/localhost-staff/ci
# STAFF_APM_FILES_ROOT=/var/staffdata/localhost-staff/apm
MIGRATE_HELPDESK_STORAGE=true
MIGRATE_STAFF_PORTAL_STORAGE=true

# --- Redis (optional — leave commented until Redis is verified) ---
# USE_REDIS=true
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# --- Laravel cache / queue / session (safe without Redis) ---
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=sp_queue_jobs
DB_QUEUE_BATCHES_TABLE=sp_job_batches
DB_QUEUE_FAILED_TABLE=sp_failed_jobs
SESSION_DRIVER=database
