<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Legacy Laravel public/ URLs → backend/ (Helpdesk-style, no /public in path)
    # e.g. /staff/staff-portal/public/auth/microsoft → /staff/staff-portal/backend/auth/microsoft
    RewriteRule ^public/(.*)$ backend/$1 [R=301,L]
    RewriteRule ^public$ backend/ [R=301,L]

    # Laravel API + web auth (Microsoft SSO, spa-bridge, Livewire)
    RewriteRule ^backend(/|$) - [L]

    # Real files at staff-portal root (README, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Built SPA assets
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ frontend/dist-build/$1 [L]

    # Vue Router fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ frontend/dist-build/index.html [L]
</IfModule>

ServerSignature Off
