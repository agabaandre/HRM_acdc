# Helpdesk client (MaterialPro shell) — served from /staff/helpdesk2/
# Shares the same Laravel API as the original helpdesk frontend.
VITE_HELPDESK_API_BASE_URL=/staff/helpdesk/backend
VITE_HELPDESK_BASE_PATH=/staff/helpdesk2/

VITE_STAFF_PORTAL_HOME_URL=/staff/home/index
VITE_STAFF_BASE_URL=/staff

# Optional: point SSO hand-off at helpdesk2 instead of helpdesk once Staff portal is updated.
# VITE_HELPDESK_PUBLIC_URL=/staff/helpdesk2/
