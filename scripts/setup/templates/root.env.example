APP_ENV=local
SITE_KIND=production
WEB_ROOT=staff
BASE_URL=http://localhost/staff/
CI_BASE_URL=http://localhost/staff/
APM_BASE_URL=http://localhost/staff/apm
STAFF_SITE_ID=localhost-staff
STAFF_HOST_DATA_ROOT=/var/staffdata
STAFF_DATA_ROOT=/var/staffdata/localhost-staff
STAFF_USE_HOST_STORAGE=true
STAFF_PORTAL_UPLOADS_ROOT=/var/staffdata/localhost-staff/ci
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=staff
# Generated by ./setup.sh when blank (shared across modules for SSO).
JWT_SECRET=
SESSION_SECRET=
STAFF_API_USERNAME=
STAFF_API_PASSWORD=
# Must match staff-portal Share config (share.api_token). Default below is the CI3/Laravel Share static token.
STAFF_API_TOKEN=YWZyY2FjZGNzdGFmZnRyYWNrZXI
# Microsoft Entra — single Azure app for login + Graph/Exchange mail (canonical)
EXCHANGE_TENANT_ID=
EXCHANGE_CLIENT_ID=
EXCHANGE_CLIENT_SECRET=
EXCHANGE_SCOPE=https://graph.microsoft.com/.default
EXCHANGE_AUTH_METHOD=client_credentials
EXCHANGE_REDIRECT_URI=http://localhost/staff/backend/oauth/callback
MICROSOFT_REDIRECT_URI=http://localhost/staff/backend/auth/microsoft/callback
# Optional Azure secret id (metadata only)
CLIENT_SEC_ID=
# Outbound mail — shared transport; apps only override FROM name/address
MAIL_TRANSPORT=exchange
MAIL_MAILER=exchange
USE_EXCHANGE_EMAIL=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_HTTP_BASE_URL=https://notifications.africacdc.org/api/v1
MAIL_HTTP_CLIENT_ID=
MAIL_HTTP_CLIENT_SECRET=
STAFF_MAIL_CONFIG_KEY=
STAFF_MAIL_DISPATCH=auto
# Password / email login on SPA (false = Microsoft button only)
ALLOW_ALTERNATIVE_LOGIN=false
