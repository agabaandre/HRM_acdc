<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Laravel API / SSO under …/risk-register/backend/*
    RewriteRule ^backend(/|$) - [L]

    # Real files at module root (README, etc.) — not directories
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Prefer latest local build when dist-build is root-owned / stale
    RewriteCond %{DOCUMENT_ROOT}/staff/modules/risk-register/frontend/dist-user/index.html -f
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ frontend/dist-user/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/staff/modules/risk-register/frontend/dist-user/index.html -f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ frontend/dist-user/index.html [L]

    # Fallback: published / older dist-build
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ frontend/dist-build/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ frontend/dist-build/index.html [L]
</IfModule>

ServerSignature Off
