<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Shared Laravel API lives under /staff/helpdesk/backend — do not intercept.
    RewriteRule ^backend(/|$) - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ ../helpdesk/client/dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ ../helpdesk/client/dist/index.html [L]
</IfModule>

ServerSignature Off
