# Helpdesk installer configuration
# Copy and edit before running ./setup.sh:
#   cp setup.env.example setup.env
#
# Values here are written into helpdesk/backend/.env (existing keys are updated).

# --- URLs (Apache layout) ---
# Local dev: keep localhost below.
# Production: leave blank or keep localhost — ./setup-production.sh auto-fills from
#   ../.env (PRODUCTION_URL / CI_BASE_URL / BASE_URL) or the server hostname (https).
APP_URL=http://localhost/staff/helpdesk/backend
HELPDESK_FRONTEND_URL=http://localhost/staff/helpdesk
HELPDESK_STAFF_PORTAL_URL=http://localhost/staff
HELPDESK_APM_BASE_URL=http://localhost/staff/apm
BASE_URL=http://localhost/staff/

# --- Application ---
APP_ENV=local
APP_DEBUG=true
# Production: use ./setup-production.sh (sets APP_ENV=production, APP_DEBUG=false by default)

# --- Production deploy (setup-production.sh) ---
# RUN_FULL_SEED=false          # use --with-demo-seed on CLI to run DatabaseSeeder (not recommended on prod)
# SKIP_LARAVEL_OPTIMIZE=false  # pass --skip-optimize to setup-production.sh to skip config/route cache

# --- Database ---
# Leave DB_PASSWORD blank to copy DB_PASS from ../.env when running setup-production.sh
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=root
DB_PASSWORD=

# --- SSO / Staff API (leave blank to copy from ../.env or ../apm/.env when present) ---
JWT_SECRET=
SESSION_SECRET=
STAFF_API_USERNAME=
STAFF_API_PASSWORD=
STAFF_API_TOKEN=

# --- Systemd (Linux servers) ---
# auto = install on Linux when systemctl exists; true = always try; false = skip
INSTALL_SYSTEMD=auto
HELPDESK_USER=www-data
HELPDESK_GROUP=www-data
PHP_BIN=/usr/bin/php
HELPDESK_HEALTH_URL=http://127.0.0.1/staff/helpdesk/backend/api/v1/health

# --- Frontend build (production API base for Vite) ---
VITE_HELPDESK_API_BASE_URL=/staff/helpdesk/backend

# --- Laravel queue (database driver; table names avoid clashing with Staff CI `jobs`) ---
DB_QUEUE_TABLE=helpdesk_queue_jobs
DB_QUEUE_BATCHES_TABLE=helpdesk_job_batches
DB_QUEUE_FAILED_TABLE=helpdesk_failed_jobs
