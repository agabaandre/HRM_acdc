<IfModule mod_rewrite.c>
    RewriteEngine On

    # Public app URL is /{webRoot}/ (repo root). Bookmarks to /{webRoot}/staff-portal/*
    # must redirect — otherwise Vue sees path /staff-portal and never mounts home.
    RewriteCond %{THE_REQUEST} \s/+(staff|demo_staff|cbp|demo_cbp|cbpdemo|demo_cbpdemo)/staff-portal[/?\s] [NC]
    RewriteRule ^(.*)$ /staff/$1 [R=301,L,QSA]

    # Laravel API / auth (requests already under …/backend/ via root rewrite)
    RewriteRule ^backend(?:/|$) - [L]

    # Already the SPA front controller — never rewrite again (prevents 500 loops)
    RewriteRule ^spa-static\.php$ - [L]

    # Hashed Vite assets → PHP static sender
    RewriteRule ^assets/([^/]+)$ spa-static.php?f=$1 [L,QSA]

    # Real files (published index.html, public-spa, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Africa map from Vite public/
    RewriteRule ^maps/([^/]+)$ public-spa/maps/$1 [L]

    # Vue Router → spa-static.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ spa-static.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>
