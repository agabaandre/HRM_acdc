<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Legacy Laravel public/ URLs → backend/
    RewriteRule ^public/(.*)$ backend/$1 [R=301,L]
    RewriteRule ^public$ backend/ [R=301,L]

    # Laravel API + web auth
    RewriteRule ^backend(/|$) - [L]

    # Real files win (published index.html + assets/ from setup-production)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Fallback: Vite dist-build (same pattern as helpdesk)
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ frontend/dist-build/$1 [L]

    # Vue Router SPA fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ frontend/dist-build/index.html [L]
</IfModule>

<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

ServerSignature Off
