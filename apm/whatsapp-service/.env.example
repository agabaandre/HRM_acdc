# APM WhatsApp worker
PORT=8765
BIND_HOST=127.0.0.1
WORKER_TOKEN=change-me-to-match-system-settings

# MySQL (same database as Laravel APM)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apm
DB_USERNAME=root
DB_PASSWORD=

# Bot owner number — digits only with country code
BOT_NUMBER=

# Auth files stored here (relative to whatsapp-service/)
AUTH_DIR=../storage/whatsapp-auth
