# Copy to /etc/staff-portal/staff-portal.env and edit for your server.
# Used by: staff-portal-queue.service, staff-portal-scheduler.service

STAFF_PORTAL_ROOT=/var/www/staff/staff-portal/backend
STAFF_PORTAL_USER=www-data
STAFF_PORTAL_GROUP=www-data
PHP_BIN=/usr/bin/php
STAFF_PORTAL_HEALTH_URL=http://127.0.0.1/staff/staff-portal/backend/up
