# DevTrack installer configuration
# Copy before first production run:
#   cp setup.env.example setup.env
#
# Root ./setup.sh and ./setup-production.sh inherit shared DB host / JWT from /staff/.env.

APP_URL=http://localhost/staff/devtrack
BASE_URL=http://localhost/staff/
WEB_ROOT=staff

APP_ENV=local
APP_DEBUG=true
APP_NAME=DevTrack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cdc_devtrack
DB_USERNAME=root
DB_PASSWORD=

# Leave blank to inherit from /staff/.env
JWT_SECRET=
SESSION_SECRET=
STAFF_API_USERNAME=
STAFF_API_PASSWORD=
STAFF_API_TOKEN=
STAFF_API_INTERNAL_BASE_URL=http://127.0.0.1/staff/backend

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Web server user/group (Linux production)
# DEVTRACK_USER=www-data
# DEVTRACK_GROUP=www-data
# PHP_BIN=/usr/bin/php
